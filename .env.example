PORT=3000
PACKAGE_NAME=com.xiangli.saynext.dev
MENTRAOS_API_KEY=your_mentraos_api_key_here
COOKIE_SECRET=replace_with_long_random_secret
OPENAI_API_KEY=your_openai_api_key_here

# LLM provider:
# - openai: uses OPENAI_API_KEY
# - ollama: uses Ollama HTTP API, local or remote
LLM_PROVIDER=openai
# Default live answer model. This path must stay very fast.
OPENAI_MODEL=gpt-5.4-nano
# Long/high-risk teleprompt model. Kept separate so live answers do not get slower.
OPENAI_LONG_MODEL=gpt-5.4-nano
# Experimental: one OpenAI conversation object per app session.
# Only final clean transcripts are committed. Assistant display outputs are deleted from the conversation by default.
OPENAI_CONVERSATION_STATE_ENABLED=false
OPENAI_CONVERSATION_KEEP_ASSISTANT_OUTPUTS=false
OPENAI_CONVERSATION_WARMUP_TIMEOUT_MS=8000
# Demo response mode:
# - empty/legacy: current flow, optional separate planner + final answer
# - single_llm: one OpenAI call does semantic planning and final output together, using startup memory seeded once
# single_llm requires LLM_PROVIDER=openai and OPENAI_CONVERSATION_STATE_ENABLED=true; otherwise SayNext falls back to legacy flow.
SAYNEXT_RESPONSE_MODE=
# Optional planner mode:
# - off: disabled
# - shadow: logs a JSON semantic plan but does not control final output
# - shape: planner controls output shape/depth only; memory retrieval still follows existing logic
# - policy: planner controls output shape/depth and whether personal memory is retrieved
SAYNEXT_PLANNER_MODE=policy
SAYNEXT_PLANNER_SHADOW_ENABLED=false
SAYNEXT_PLANNER_MODEL=gpt-5.4-nano
SAYNEXT_PLANNER_TIMEOUT_MS=1800
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct
OLLAMA_TIMEOUT_MS=30000

PIPELINE_OLLAMA_MODEL=qwen2.5:14b-instruct
PIPELINE_OLLAMA_TIMEOUT_MS=90000
PERSONALIZATION_PIPELINE_ENABLED=false

DATA_LOGGING_ENABLED=true
SAYNEXT_DB_PATH=./data/saynext.sqlite

# Runtime mode:
# - local: home mode, local DB is source of truth, session memory can use Ollama.
# - travel: VPS mode, VPS DB is source of truth, session memory is synchronous OpenAI and batch is disabled.
SAYNEXT_RUNTIME_MODE=local
SESSION_MEMORY_PROVIDER=ollama
SESSION_MEMORY_BATCH_ENABLED=false
SESSION_MEMORY_OPENAI_MODEL=gpt-5.4-nano
SESSION_MEMORY_OPENAI_TIMEOUT_MS=180000

# EvenHub G2 support. v1 and v2 share this STT configuration.
# Without a STT provider, G2 microphone audio is accepted but cannot be transcribed;
# debug transcript input still works.
EVENHUB_DEFAULT_USER_ID=xiang
EVENHUB_RELAY_TOKEN=
EVENHUB_V2_RELAY_TOKEN=
EVENHUB_STT_PROVIDER=
DEEPGRAM_API_KEY=
EVENHUB_STT_MODEL=nova-3
EVENHUB_STT_LANGUAGE=en
EVENHUB_STT_SAMPLE_RATE=16000
EVENHUB_STT_ENDPOINTING_MS=300
EVENHUB_STT_PARTIAL_COMMIT_MS=1200
EVENHUB_V2_STT_PARTIAL_COMMIT_MS=1200
EVENHUB_V2_AUTO_CUE_MODEL=gpt-5.4-mini
EVENHUB_V2_OPENAI_CONVERSATION_TIMEOUT_MS=2500
EVENHUB_V2_MEMORY_SEARCH_MODE=lexical
EVENHUB_V2_ACTIVE_INTERVIEW_QUERY=
EVENHUB_SESSION_RESUME_TTL_MS=600000

# Not needed for SayNext MVP.
SERPAPI_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_WEATHER_API_KEY=
