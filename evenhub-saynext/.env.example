# Optional. Leave empty to use the production SayNext VPS websocket.
# Set this only when you are running the SayNext backend locally.
VITE_SAYNEXT_WS_URL=

# Optional relay token. If the VPS has EVENHUB_RELAY_TOKEN enabled, put the
# same value here before running npm run pack.
VITE_SAYNEXT_RELAY_TOKEN=
